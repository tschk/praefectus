PRODUCT_BUNDLE_IDENTIFIER = org.praefectus.iphone.reference
PRODUCT_NAME = $(TARGET_NAME)
ARCHS = arm64
ALWAYS_SEARCH_USER_PATHS = NO
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Bridge.h
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Praefectus
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Connect to this iPhone's paired developer services through your loopback VPN.
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
OTHER_LDFLAGS = $(inherited) -lpraefectus_iphone_host -framework Security -framework SystemConfiguration -framework CoreFoundation -liconv
LIBRARY_SEARCH_PATHS = $(inherited) $(PRAEFECTUS_RUST_LIB_DIR)
ENABLE_USER_SCRIPT_SANDBOXING = YES
